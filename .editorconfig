# Chronoscope — конфигурация редакторов
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Форматы данных и конфигурации
[*.{json,yml,yaml,toml}]
indent_size = 2

# Проектные файлы .NET / MSBuild
[*.{csproj,props,targets,sln}]
indent_size = 2

# Markdown: висячие пробелы могут быть значимыми (жёсткий перенос строки)
[*.md]
trim_trailing_whitespace = false

# PowerShell
[*.ps1]
indent_size = 4
