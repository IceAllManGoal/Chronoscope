<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Платформенно-нейтральное ядро Agent: контракт, идентичность, конфигурация,
    транспорт, абстракции коллекторов и логирование. Библиотека, а не исполняемый
    проект: точкой входа владеет Chronoscope.Agent.Host, потому что композиционный
    корень обязан знать и ядро, и платформенный коллектор, а платформенный
    коллектор ссылается на ядро. Если бы точка входа жила здесь, ссылка была бы
    встречной и проект не собрался бы.

    OutputType намеренно не задан: проект не содержит точки входа.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Chronoscope.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
